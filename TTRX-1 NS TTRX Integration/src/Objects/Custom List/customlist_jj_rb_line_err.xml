<customlist scriptid="customlist_jj_rb_line_err">
  <description>Line-level rejection codes. An inbound write is ALL-OR-NOTHING: any line failure rejects the whole receipt or fulfilment, and the failure envelope names every failing line in failed_lines[]. A success carries no per-line array.</description>
  <isinactive>F</isinactive>
  <ismatrixoption>F</ismatrixoption>
  <isordered>T</isordered>
  <name>RapidBridge Inbound Line Error</name>
  <customvalues>
    <customvalue scriptid="val_line_not_on_order">
      <isinactive>F</isinactive>
      <value>LINE_NOT_ON_ORDER</value>
    </customvalue>
    <customvalue scriptid="val_bad_quantity">
      <isinactive>F</isinactive>
      <value>BAD_QUANTITY</value>
    </customvalue>
    <customvalue scriptid="val_qty_exceeds_remaining">
