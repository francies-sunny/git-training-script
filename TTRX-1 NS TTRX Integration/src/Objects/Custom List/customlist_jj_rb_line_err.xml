      <isinactive>F</isinactive>
      <value>BIN_NOT_ALLOWED</value>
    </customvalue>
    <customvalue scriptid="val_unknown_list_value">
      <isinactive>F</isinactive>
      <value>UNKNOWN_LIST_VALUE</value>
    </customvalue>
    <customvalue scriptid="val_bad_date">
      <isinactive>F</isinactive>
      <value>BAD_DATE</value>
    </customvalue>
    <customvalue scriptid="val_lot_required">
      <isinactive>F</isinactive>
      <value>LOT_REQUIRED</value>
